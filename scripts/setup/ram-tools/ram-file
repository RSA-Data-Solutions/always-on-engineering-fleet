#!/usr/bin/env python3
"""ram-file — file a build/fix/change request as one Paperclip issue owned by Ram.

  ram-file --title "Short title" --request "Full request, the person's own words + constraints" [--thread 1790.123] [--force]

Filing assigns the issue to Ram in Paperclip, which wakes him to write the spec and route it
(Sam builds -> Lynn tests -> merge -> Aaron deploys). The result is posted back in the Slack thread.
Refuses (returns the existing issue) if a similar unfinished request already exists, so a repeated or
re-worded message can't create a duplicate. Prints ONE JSON object; report only what it says.
"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import ram_common as rc


def _main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--title", required=True)
    ap.add_argument("--request", required=True)
    ap.add_argument("--thread", default="")
    ap.add_argument("--force", action="store_true", help="file even if a similar request exists")
    a = ap.parse_args()
    rc.refuse_in_worker()
    if len(a.request.split()) < 5:
        rc.die("the request is too short to act on — write the goal, the project, and what 'done' looks like.")
    issues = rc.open_issues()
    if not a.force:
        dup = rc.find_duplicate(a.title, a.request, rc.open_requests(issues))
        if dup:
            print(json.dumps({
                "status": "duplicate", "existing": dup["identifier"], "title": dup["title"],
                "where": rc.where(dup, rc.current_stage(dup, issues)),
                "message": f"A similar request is already open as {dup['identifier']} — nothing was filed. "
                           f"Tell the person; if it is genuinely a different request, re-run with --force.",
            }))
            return
    origin = f"slack thread_ts={a.thread}" if a.thread else "slack"
    issue = rc.cli("issue", "create", "-C", rc.COMPANY_ID, "--project-id", rc.PROJECT_ID,
                   "--assignee-agent-id", rc.RAM_ID, "--status", "todo", "--title", f"Feature: {a.title}",
                   "--description", f"ORIGIN: {origin}\nRequest: {a.request}")
    print(json.dumps({"status": "filed", "request": issue["identifier"],
                      "message": f"Filed as {issue['identifier']}. It goes to Sam to build, Lynn to test, then Aaron to "
                                 f"deploy; the result is posted in this thread."}))


def main():
    try:
        _main()
    except rc.RamError as e:
        rc.die(str(e))


if __name__ == "__main__":
    main()
