#!/usr/bin/env python3
"""ram-answer — pass the requester's answer back to a request Ram paused to ask about.

  ram-answer RSA-31 "the person's answer, verbatim"

Use ONLY for replies to a question Ram posted about a request (it names the RSA number). It records the
answer on the request and wakes Ram in Paperclip to continue. Do NOT file a new request for a reply.
"""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import ram_common as rc


def _main():
    if len(sys.argv) < 3:
        rc.die("usage: ram-answer RSA-NN \"the person's answer\"")
    rc.refuse_in_worker()
    ref, answer = sys.argv[1], " ".join(sys.argv[2:]).strip()
    if not answer:
        rc.die("the answer is empty")
    parent = rc.request_of(rc.resolve(ref))
    if parent.get("status") not in rc.OPEN:
        rc.die(f"{parent['identifier']} is already {parent['status']}; nothing to answer. Use ram-status.")
    rc.cli("issue", "update", parent["id"], "--status", "in_progress",
           "--comment", f"Answer from the requester (via Slack):\n\n{answer}")
    rc.wake_ram(parent["id"], "requester_answered")
    print(json.dumps({"status": "answered", "request": parent["identifier"],
                      "message": f"Your answer is on {parent['identifier']}; work continues from there."}))


def main():
    try:
        _main()
    except rc.RamError as e:
        rc.die(str(e))


if __name__ == "__main__":
    main()
