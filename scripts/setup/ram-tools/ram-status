#!/usr/bin/env python3
"""ram-status — what is actually in flight. Report exactly what this prints; never guess.

  ram-status            every unfinished request and the stage it is at
  ram-status RSA-30     one request in detail (stages + recent history)
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import ram_common as rc


def _main():
    rc.refuse_in_worker()
    if len(sys.argv) > 1:
        parent = rc.request_of(rc.resolve(sys.argv[1]))
        kids = sorted((i for i in rc.cli("issue", "list", "-C", rc.COMPANY_ID) if i.get("parentId") == parent["id"]),
                      key=lambda i: i.get("createdAt") or "")
        open_kids = [k for k in kids if k["status"] in rc.OPEN]
        print(f"{parent['identifier']}  {parent['title']}\nstatus: {parent['status']}  |  "
              f"{rc.where(parent, open_kids[-1] if open_kids else None)}")
        if kids:
            print("\nStages:")
            for k in kids:
                print(f"- {k['identifier']}  {k['title'][:60]}  —  {k['status']} "
                      f"({rc.AGENTS.get(k.get('assigneeAgentId') or '', 'unassigned')})")
        print("\nRecent history:")
        for c in rc.comments(parent["id"])[-6:]:
            who = rc.AGENTS.get(c.get("authorAgentId") or "", c.get("authorType") or "?")
            body = " ".join((c.get("body") or "").split())
            print(f"- [{c['createdAt'][5:16]}] {who}: {body[:260]}")
        return
    issues = rc.open_issues()
    reqs = rc.open_requests(issues)
    if not reqs:
        print("Nothing in flight: no unfinished requests.")
        return
    print(f"{len(reqs)} unfinished request(s):")
    for r in reqs:
        print(f"- {r['identifier']}  {r['title'][:70]}  —  {rc.where(r, rc.current_stage(r, issues))}")


def main():
    try:
        _main()
    except rc.RamError as e:
        rc.die(str(e))


if __name__ == "__main__":
    main()
