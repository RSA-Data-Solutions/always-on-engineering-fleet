[Unit]
Description=Pipeline Advancer — periodic handoff-check heartbeat trigger

[Timer]
# 30s, the same cadence as Paperclip's own per-agent heartbeat, so a finished
# stage is handed to the next agent within ~30s. An idle pass is a few
# read-only CLI calls.
OnBootSec=60
OnUnitActiveSec=30
AccuracySec=5

[Install]
WantedBy=timers.target
