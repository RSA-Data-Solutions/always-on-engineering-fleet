# Pipeline Advancer environment
#
# Copy to ~/.pipeline-advancer/.env (mode 600, owned by the user running the
# service — `sashi` on the live host) and fill in real values.
# NEVER commit this file with real values. It is not tracked in this repo —
# only the .example template is.

# Paperclip company id (paperclipai company list) — same one every other
# fleet component uses.
PAPERCLIP_COMPANY_ID=0c265070-3974-497a-99ee-cf942ffe139d

# A read-capable Paperclip API key, used ONLY by verify.sh for manual
# dry-run testing outside of a real heartbeat. At actual runtime (systemd
# timer -> `agent heartbeat:invoke` -> Paperclip's own process adapter),
# Paperclip injects a fresh run-scoped PAPERCLIP_API_KEY into the child
# process itself — this .env value is never read on that path. Mint this
# the same way claude-supervisor's was minted (paperclipai token agent
# create) once the pipeline-advancer agent identity exists.
PAPERCLIP_API_KEY=

# Board-level Paperclip API key, used ONLY for the mutating calls (issue
# reassign/status/comment) — the run-scoped key Paperclip injects per
# heartbeat can't write due to upstream bug paperclipai/paperclip#13708 (see
# pipeline_advancer.py's board_workaround_key() docstring). You can point
# this at the SAME key claude-supervisor's ~/.claude-supervisor/.env already
# uses (one board-level key covering both daemons' writes), or mint a
# separate one for narrower blast radius / independent revocation — your
# call, note which you picked here once decided:
PAPERCLIP_BOARD_KEY_WORKAROUND=

# Slack — same bot token Hermes already uses (~/.hermes/.env's
# SLACK_BOT_TOKEN), so pipeline status messages land in the same Slack app.
SLACK_BOT_TOKEN=

# The one Slack user id Ram is allowed to talk to (~/.hermes/.env's
# SLACK_ALLOWED_USERS, single value on this install) — chat.postMessage with
# channel=<this user id> opens/reuses the existing DM with them, so status
# updates land in "the same channel Ram already talks in" per the design
# decision, without needing a separate channel id.
PIPELINE_SLACK_USER_ID=

# --- Optional tunables (defaults shown; leave commented out to keep them) ---
# How many times an issue may bounce back to Sam (Lynn "code_bug" or Claude
# "rework") before it is blocked and a human is notified.
# PIPELINE_MAX_REWORK=2
# 1 = also DM every stage handoff. Default is quiet: only "needs a human"
# events and the final published result reach Slack.
# PIPELINE_SLACK_VERBOSE=0
