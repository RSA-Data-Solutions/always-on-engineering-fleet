[Unit]
Description=Claude Supervisor — advisory review daemon for the Paperclip/Hermes fleet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.claude-supervisor/.env
ExecStart=/usr/bin/env python3 %h/.claude-supervisor/claude_supervisor.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
